{
    "basic": {
        "description": "🎛 基础",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用插件",
                "type": "bool",
                "hint": "关掉后 /dsh 完全无响应，配置保留",
                "default": true
            },
            "prefix": {
                "description": "触发前缀",
                "type": "string",
                "hint": "默认 dsh，即发送 /dsh 内容。与其它插件命令冲突时改这里",
                "default": "dsh"
            }
        }
    },
    "admin": {
        "description": "👑 管理员",
        "type": "object",
        "items": {
            "admin_list": {
                "description": "管理员名单",
                "type": "list",
                "hint": "只接受 FriendMessage 类型的会话 ID，一行一个。\n获取方式：私聊机器人发 /sid，把整行复制进来。\n示例：肥嘟嘟:FriendMessage:2809688590\n\n管理员可以：切换权限（私聊可到完全访问）、初始化 profile、重置会话、修改白名单/权限档/文件上限。\n填成群会话 ID 会被忽略。",
                "default": []
            }
        }
    },
    "paths": {
        "description": "🧠 路径与模型",
        "type": "object",
        "items": {
            "scratch_dir": {
                "description": "工作区目录",
                "type": "string",
                "hint": "DSH 的运行目录：没写路径的文件都落在这里。留空则用 用户目录/dsh-bot-workspace",
                "default": ""
            },
            "dsh_cli_path": {
                "description": "DSH CLI 路径",
                "type": "string",
                "hint": "留空自动探测（安装目录 / PATH）。写错会直接报错，不会静默回退",
                "default": ""
            }
        }
    },
    "private": {
        "description": "💬 私聊",
        "type": "object",
        "items": {
            "allow_private": {
                "description": "允许私聊使用",
                "type": "bool",
                "hint": "关闭后私聊里的 /dsh 不响应",
                "default": true
            },
            "private_whitelist": {
                "description": "私聊白名单",
                "type": "list",
                "hint": "只接受 FriendMessage 类型的会话 ID。\n获取方式：私聊机器人发 /sid，复制整行。\n示例：肥嘟嘟:FriendMessage:2809688590\n\n白名单用户：可执行任务；私聊内可自行把权限切到「工作区写」，但切不到「完全访问」（管理员专属）。",
                "default": []
            },
            "private_default_permission": {
                "description": "私聊默认权限",
                "type": "string",
                "options": ["ro", "ws", "full"],
                "hint": "ro=只读；ws=只能写工作区；full=全盘可写（仅管理员能真正用上）",
                "default": "ws"
            },
            "allow_switch_private": {
                "description": "允许在私聊里切换权限",
                "type": "bool",
                "hint": "关闭后私聊里 /dsh perm 一律拒绝",
                "default": true
            },
            "private_attach_max_mb": {
                "description": "私聊接收附件上限（MB）",
                "type": "int",
                "hint": "QQ 发来的文件/图片上限，1–100。超过会被拒收",
                "default": 50
            },
            "private_file_max_mb": {
                "description": "私聊回传文件上限（MB）",
                "type": "int",
                "hint": "DSH 产出的文件上限，1–100。超过只回路径",
                "default": 50
            },
            "private_file_max_count": {
                "description": "私聊单任务回传数量",
                "type": "int",
                "hint": "一次任务最多发回几个文件，1–10",
                "default": 5
            }
        }
    },
    "group": {
        "description": "👥 群聊",
        "type": "object",
        "items": {
            "allow_group": {
                "description": "允许群聊使用",
                "type": "bool",
                "hint": "关闭后群里 @机器人 发 /dsh 也不响应",
                "default": false
            },
            "group_shared_context": {
                "description": "共用一个上下文的群",
                "type": "list",
                "hint": "只接受 GroupMessage 类型的会话 ID，一行一个；这个列表同时就是群白名单。\n获取方式：在群里 @机器人 发 /sid，复制整行。\n示例：肥嘟嘟:GroupMessage:1132855958\n\n列在这里的群：所有发言者共用一个 DSH 会话。",
                "default": []
            },
            "group_isolated_context": {
                "description": "每人独立上下文的群",
                "type": "list",
                "hint": "只接受 GroupMessage 类型的会话 ID；同样是群白名单。\n列在这里的群：每个发言者各用一个 DSH 会话，互不串台。\n\n注意：同一个群不要同时出现在两个列表；若重复，按「共用一个上下文」处理并提示。\n两个列表都没有的群：完全不响应。",
                "default": []
            },
            "group_default_permission": {
                "description": "群聊默认权限",
                "type": "string",
                "options": ["ro", "ws"],
                "hint": "群里持久权限最高只到 ws（工作区写）。需要完全访问时，管理员可用一次性提权（仅下一条任务）",
                "default": "ro"
            },
            "allow_switch_group": {
                "description": "允许在群里切换权限",
                "type": "bool",
                "hint": "只有管理员能切；普通群成员发 /dsh perm 会被拒绝。设为关则管理员也不能切",
                "default": true
            },
            "group_attach_max_mb": {
                "description": "群聊接收附件上限（MB）",
                "type": "int",
                "hint": "群成员发来的文件上限，1–100；建议比私聊小",
                "default": 20
            },
            "group_file_max_mb": {
                "description": "群聊回传文件上限（MB）",
                "type": "int",
                "hint": "群里回传文件上限，1–100",
                "default": 20
            },
            "group_file_max_count": {
                "description": "群聊单任务回传数量",
                "type": "int",
                "hint": "群里一次任务最多发回几个文件，1–5",
                "default": 3
            }
        }
    },
    "session": {
        "description": "⚙️ 会话",
        "type": "object",
        "items": {
            "session_ttl_hours": {
                "description": "会话过期小时",
                "type": "float",
                "hint": "超过这个时长没有新任务就自动开新会话，避免上下文无限膨胀；0=永不过期",
                "default": 24
            },
            "session_notice": {
                "description": "回复里标注会话状态",
                "type": "bool",
                "hint": "在简报末尾显示「新会话 / 续接第 N 轮」",
                "default": true
            }
        }
    },
    "limits": {
        "description": "⏱ 限制",
        "type": "object",
        "items": {
            "timeout_sec": {
                "description": "单任务超时（秒）",
                "type": "int",
                "hint": "到点会杀掉整个进程树并回执失败，范围 30–1800",
                "default": 600
            },
            "max_msg_chars": {
                "description": "单条消息上限（字）",
                "type": "int",
                "hint": "超过直接拒绝，避免一次塞太多",
                "default": 4000
            },
            "max_buffer_chars": {
                "description": "多段缓冲上限（字）",
                "type": "int",
                "hint": "多段收集总长度上限，超过拒绝继续追加",
                "default": 8000
            },
            "brief_chars": {
                "description": "简报字数上限",
                "type": "int",
                "hint": "超出会截断，并把完整内容另存到工作区 .dsh-bridge/out/",
                "default": 400
            },
            "idle_minutes": {
                "description": "收集空闲分钟",
                "type": "int",
                "hint": "多段收集时，多少分钟没有新片段就触发自动动作；0=不自动",
                "default": 3
            },
            "idle_action": {
                "description": "空闲后动作",
                "type": "string",
                "options": ["submit", "discard"],
                "hint": "submit=自动提交执行；discard=自动丢弃",
                "default": "submit"
            }
        }
    }
}
